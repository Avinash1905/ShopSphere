{
  "name": "shopsphere-backend",
  "version": "1.0.0",
  "description": "ShopSphere Enterprise Backend - Member 2 Phase 1 (Foundation, Auth & Users)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --import tsx src/server.ts",
