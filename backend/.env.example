# ==============================================================================
# ShopSphere Backend Environment Configuration (.env.example)
# Member 2 - Phase 1: Backend Foundation + Authentication + Users
# NOTE: Safe placeholder values for local development. NO external API keys required.
# ==============================================================================

# Server & Application Settings
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME=ShopSphere-Backend
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# Security & CORS Settings
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
COOKIE_SECRET=change-this-local-cookie-secret-min-32-chars-for-dev-only
TRUST_PROXY=false

# Authentication & Token Configuration (Local JWT & Cryptographic Salts)
JWT_ACCESS_SECRET=local-jwt-access-secret-minimum-32-characters-dev-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=local-jwt-refresh-secret-minimum-32-characters-dev-key
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=shopsphere-auth-service
JWT_AUDIENCE=shopsphere-api-clients

# Password & Security Policies
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true
PASSWORD_SALT_ROUNDS=10

# Account Lockout & Abuse Protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
RESET_TOKEN_EXPIRES_MINUTES=15

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Logging & Auditing
LOG_LEVEL=debug
LOG_FORMAT=pretty
ENABLE_AUDIT_LOG=true

# Database Adapter Configuration (Member 3 Boundary)
# Default 'memory' adapter is completely self-contained for Member 2 Phase 1
DATABASE_ADAPTER=memory
DATABASE_URL=
