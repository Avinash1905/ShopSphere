# ShopSphere Environment Configuration Template
# Copy this file to .env and configure local development variables

# Application
NODE_ENV=development
PORT=5000
VITE_API_URL=http://localhost:5000

# Database
DATABASE_URL="file:./database/dev.db"

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Feature Flags
ENABLE_MOCK_PAYMENT_SIMULATOR=true
ENABLE_ANALYTICS_TELEMETRY=true
ENABLE_TAMPER_AUDIT_LOGGING=true
